# Zephyra Lite — backend environment template.
# Copy to .env and fill in. Never commit the real .env.

NVIDIA_API_KEY=
ZEPHYRA_MODEL=meta/llama-3.1-8b-instruct
DATABASE_URL=sqlite:///data/zephyra.db
NVIDIA_API_BASE=https://integrate.api.nvidia.com/v1

# Phase 5 research. SEARCH_PROVIDER must name an approved Search API provider
# registered in app/services/search/__init__.py; "none" makes research fail
# explicitly instead of answering from general model knowledge.
SEARCH_PROVIDER=none
SEARCH_TIMEOUT_SECONDS=8
RESEARCH_BUDGET_SECONDS=15
RESEARCH_MAX_SOURCES=5
RESEARCH_SNIPPET_MAX_CHARS=500
