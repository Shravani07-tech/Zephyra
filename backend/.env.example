# Zephyra Lite — backend environment template.
# Copy to .env and fill in. Never commit the real .env.

# Chat model provider:
#   auto   - NVIDIA (hosted) when NVIDIA_API_KEY is set and reachable; local
#            Ollama when offline, unconfigured, or NVIDIA fails (recommended)
#   nvidia - NVIDIA only        ollama - local Ollama only
LLM_PROVIDER=auto

# Ollama (local). Pull the models first:
#   ollama pull llama3.2 && ollama pull nomic-embed-text
# The embedding model is also used by the File Assistant and Persistent Memory,
# so Ollama must be running even when chat uses NVIDIA.
OLLAMA_API_BASE=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2:latest
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# NVIDIA (hosted), used when LLM_PROVIDER=auto or nvidia.
NVIDIA_API_KEY=
NVIDIA_API_BASE=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct

# Optional. Defaults to an absolute path under backend/data; a relative
# sqlite:/// URL is resolved against the directory the server is started from.
# DATABASE_URL=sqlite:///data/zephyra.db

# Phase 5 research. SEARCH_PROVIDER must name an approved Search API provider
# registered in app/services/search/__init__.py; "none" makes research fail
# explicitly instead of answering from general model knowledge.
# To enable web research with Tavily (free tier: 1,000 searches/month, no card,
# key from https://app.tavily.com), set SEARCH_PROVIDER=tavily and the key below.
SEARCH_PROVIDER=none
TAVILY_API_KEY=
SEARCH_TIMEOUT_SECONDS=8
RESEARCH_BUDGET_SECONDS=15
RESEARCH_MAX_SOURCES=5
RESEARCH_SNIPPET_MAX_CHARS=500
